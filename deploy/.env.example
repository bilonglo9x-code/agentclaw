# ── GoClaw Coolify Deployment — .env ──────────────────────────────────────────
# Copy this file to .env and fill in all required values before deploying.
# Run: ./prepare-env.sh  (auto-generates GOCLAW_GATEWAY_TOKEN and GOCLAW_ENCRYPTION_KEY)

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=goclaw
POSTGRES_PASSWORD=          # REQUIRED: strong random password
POSTGRES_DB=goclaw

# ── GoClaw Core ────────────────────────────────────────────────────────────────
GOCLAW_PORT=18790
GOCLAW_GATEWAY_TOKEN=       # REQUIRED: run `openssl rand -hex 32`
GOCLAW_ENCRYPTION_KEY=      # REQUIRED: run `openssl rand -hex 32`

# ── Optional LLM Provider Keys ─────────────────────────────────────────────────
# Add in GoClaw admin UI after first boot, or pre-set here:
# GOCLAW_OPENAI_API_KEY=
# GOCLAW_ANTHROPIC_API_KEY=
# GOCLAW_OPENROUTER_API_KEY=
# GOCLAW_GROQ_API_KEY=

# ── Optional Features ──────────────────────────────────────────────────────────
# GOCLAW_TRACE_VERBOSE=0
